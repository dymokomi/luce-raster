## The byte reader, the growing buffer, extents and the float and half conversions.

test "a reader takes integers in either byte order and fails past the end":
    let data: u8[6] = [0x01, 0x02, 0x03, 0x04, 0xAB, 0xCD]
    var little = Reader(data = data, position = 0)
    assert(try little.uint(2) == 0x0201)
    assert(try little.byte() == 0x03)
    var big = Reader(data = data, position = 0, little = false)
    assert(try big.uint(4) == 0x01020304)
    assert(try big.uint(2) == 0xABCD)
    var truncated = false
    _ = big.byte() catch failure:
        truncated = failure.code == corrupt
        recover 0
    assert(truncated and big.position == 6)
    var wide = false
    _ = big.uint(9) catch failure:
        wide = failure.code == corrupt
        recover 0
    assert(wide)

test "a reader's cstring stops at the zero and refuses one past its maximum":
    let data: u8[9] = [0x61, 0x62, 0x00, 0x63, 0x64, 0x65, 0x66, 0x67, 0x00]
    var reader = Reader(data = data, position = 0)
    assert(try reader.cstring() == "ab" and reader.position == 3)
    var long = false
    _ = reader.cstring(maximum = 3) catch failure:
        long = failure.code == corrupt
        recover ""
    assert(long)

test "a buffer grows, writes integers both ways and keeps a byte limit":
    var buffer: Buffer
    defer buffer.close()
    try buffer.uint(0x0102, 2)
    try buffer.uint(0x0304, 2, little = false)
    try buffer.text("hi", terminated = true)
    for i in 0..<1000: try buffer.byte((u8)(i % 251))
    let view = buffer.view()
    assert(view.length == 1007 and view[0] == 0x02 and view[1] == 0x01 and view[2] == 0x03 and view[3] == 0x04)
    assert(view[4] == 0x68 and view[5] == 0x69 and view[6] == 0 and view[1006] == (u8)(999 % 251))
    var small = Buffer(maximum = 4)
    defer small.close()
    try small.put(b"abcd")
    var refused = false
    small.byte(1) catch failure:
        refused = failure.code == limit
    assert(refused and small.used == 4)

test "a slice inside the data is taken and one outside is corrupt":
    let data: u8[4] = [1, 2, 3, 4]
    let inner = try slice(data, 1, 2)
    assert(inner.length == 2 and inner[0] == 2 and inner[1] == 3)
    var outside = 0
    _ = slice(data, 3, 2) catch failure:
        if failure.code == corrupt: outside += 1
        recover inner
    _ = slice(data, 5, 0) catch failure:
        if failure.code == corrupt: outside += 1
        recover inner
    assert(outside == 2)

test "float, double and half bits round-trip":
    assert(float_bits(1.0) == 0x3F800000 and float_value(0x3F800000) == 1.0)
    assert(double_bits(-2.0) == 0xC000000000000000 and double_value(double_bits(0.1)) == 0.1)
    assert(half(0x3C00) == 1.0 and half(0xC000) == -2.0 and half(0x0001) > 0.0)
    assert(to_half(1.0) == 0x3C00 and to_half(-2.0) == 0xC000 and to_half(65504.0) == 0x7BFF)
    assert(to_half(1.0e9) == 0x7C00 and to_half(1.0e-10) == 0)
    for bits in [(u16)0x3555, (u16)0x0400, (u16)0x7BFF, (u16)0x0001, (u16)0x8123]:
        assert(to_half(half(bits)) == bits)
